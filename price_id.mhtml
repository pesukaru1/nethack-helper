@charset "utf-8";

img { image-rendering: pixelated; }

.ui-draggable-handle { cursor: move; }

div.thumb { border-color: transparent; }

#mw-anon-edit-warning, #mw-read-only-warning { color: black; background-color: yellow; border: 0.5em solid red; padding: 0.5em; margin: 0.5em; }

.previewnote-inner-msg { background-color: rgb(255, 224, 224); border: 0.2em solid red; padding: 0.5em; }

pre { overflow: auto; }

table.wikitable, table.prettytable { margin: 1em 1em 1em 0px; background: rgb(249, 249, 249); border: 1px solid rgb(170, 170, 170); border-collapse: collapse; }

table.wikitable th, table.wikitable td, table.prettytable th, table.prettytable td { border: 1px solid rgb(170, 170, 170); padding: 0.2em; }

table.wikitable th, table.prettytable th { background: rgb(242, 242, 242); text-align: center; }

table.wikitable caption, table.prettytable caption { margin-left: inherit; margin-right: inherit; }

.mw-interwikitable-row:hover { background-color: rgb(224, 224, 224); }

.nhencyclopedia { font-family: "Palatino Linotype"; font-style: italic; background-color: rgb(191, 191, 142); border: 2px dashed rgb(181, 181, 132); margin: 0.5em; padding: 1em; width: 60%; }

.nhguidebook { font-family: monospace, serif; background-color: rgb(248, 240, 240); border: 2px dashed rgb(223, 208, 208); margin: 0.25em; padding: 0.5em; width: 60%; }

